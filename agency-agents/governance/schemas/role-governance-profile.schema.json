{
  "$defs": {
    "actionList": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "type": "array",
      "uniqueItems": true
    },
    "sideEffect": {
      "enum": [
        "write",
        "external_side_effect"
      ],
      "type": "string"
    },
    "approvalDecision": {
      "enum": [
        "self-service",
        "current-user-approval",
        "current-user-and-supervisor"
      ],
      "type": "string"
    }
  },
  "$id": "https://agency-agents.local/governance/schemas/role-governance-profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_read_actions": {
      "$ref": "#/$defs/actionList",
      "type": "array"
    },
    "allowed_systems": {
      "$ref": "#/$defs/actionList",
      "type": "array"
    },
    "allowed_write_actions": {
      "$ref": "#/$defs/actionList",
      "type": "array"
    },
    "approval_matrix": {
      "additionalProperties": false,
      "properties": {
        "high": {
          "$ref": "#/$defs/approvalDecision"
        },
        "low": {
          "$ref": "#/$defs/approvalDecision"
        },
        "medium": {
          "$ref": "#/$defs/approvalDecision"
        }
      },
      "required": [
        "low",
        "medium",
        "high"
      ],
      "type": "object"
    },
    "division": {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
    },
    "exception_source": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "forbidden_actions": {
      "$ref": "#/$defs/actionList",
      "type": "array"
    },
    "policy_source": {
      "maxLength": 500,
      "minLength": 1,
      "type": "string"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "risk_rules": {
      "$ref": "#/$defs/actionList",
      "type": "array"
    },
    "role_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
    },
    "role_name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "source_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "source_path": {
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,499}$",
      "type": "string"
    },
    "side_effects": {
      "items": {
        "$ref": "#/$defs/sideEffect"
      },
      "maxItems": 2,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "role_id",
    "role_name",
    "division",
    "risk_level",
    "allowed_read_actions",
    "allowed_write_actions",
    "forbidden_actions",
    "risk_rules",
    "allowed_systems",
    "approval_matrix",
    "side_effects",
    "source_hash",
    "source_path",
    "policy_source",
    "exception_source"
  ],
  "title": "Agency Agents Role Governance Profile",
  "type": "object"
}
